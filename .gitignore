# Data directories (do not commit raw multi-GB CSVs or extracts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Model checkpoints and large binaries
artifacts/models/*.pt
artifacts/models/*.json
artifacts/models/*.pkl
artifacts/models/*.joblib
!artifacts/models/.gitkeep

# Results and logs
results/cache/
*.log
*.bak*
*.bak

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
